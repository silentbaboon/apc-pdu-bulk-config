#!/usr/bin/expect -f
# Usage: ./apc_setup.exp <ip> <current_password> <new_password> <location> <contact>

set ipaddr        [lindex $argv 0]
set password      [lindex $argv 1]
set new_password  [lindex $argv 2]
set location      [lindex $argv 3]
set contact       [lindex $argv 4]
set timeout 30

spawn ssh -o StrictHostKeyChecking=no \
          -o KexAlgorithms=ecdh-sha2-nistp256,diffie-hellman-group14-sha256 \
          -o Ciphers=aes128-ctr,aes256-ctr,aes128-cbc,aes256-cbc \
          -o HostKeyAlgorithms=ecdsa-sha2-nistp256 \
          apc@$ipaddr

expect "*?assword*"
send "$password\r"

# After first password attempt, handle three possible outcomes:
# 1. Permission denied — password is already changed, try new_password
# 2. Forced first-login password change prompt
# 3. Normal apc> prompt — already logged in
expect {
    "Permission denied" {
        expect "*?assword*"
        send "$new_password\r"
        expect {
            "Enter current password:" {
                send "$new_password\r"
                expect "Enter new password:"
                send "$new_password\r"
                expect "Confirm new password:"
                send "$new_password\r"
                expect "apc>"
            }
            "apc>" {
                # Logged in with new_password, no change needed
            }
        }
    }
    "Enter current password:" {
        send "$password\r"
        expect "Enter new password:"
        send "$new_password\r"
        expect "Confirm new password:"
        send "$new_password\r"
        expect "apc>"
    }
    "apc>" {
        # Logged in with password, no change needed
    }
}

# Set location and contact via CLI
send "system -l \"$location\"\r"
expect "apc>"
send "system -c \"$contact\"\r"
expect "apc>"

# Enable FTP
send "ftp -S enable\r"
expect "apc>"

# Reboot to apply all changes
send "reboot -Y\r"
expect eof
